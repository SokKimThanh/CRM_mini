@inherits LayoutComponentBase

@* 4 Providers thiết yếu để MudBlazor hiển thị Theme, Popups, Dialogs và Snackbars *@
<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="MudBlazor.Color.Primary">
        <MudText Typo="Typo.h6">CRM Enterprise — Day 1 Blazor Server PoC</MudText>
        <MudSpacer />
        <MudChip T="string" Color="MudBlazor.Color.Secondary" Variant="Variant.Filled" Size="MudBlazor.Size.Small">
            Interactive Server
        </MudChip>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>