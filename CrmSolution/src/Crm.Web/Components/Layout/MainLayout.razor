@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">CRM System</MudText>
        <MudSpacer />
        <MudText Class="mr-4">@context?.User?.Identity?.Name</MudText>
        <MudButton Href="/logout" Color="MudBlazor.Color.Inherit">Đăng xuất</MudButton>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    private AuthenticationState? context;

    protected override async Task OnInitializedAsync()
    {
        if (authenticationState is not null)
        {
            context = await authenticationState;
        }
    }
}