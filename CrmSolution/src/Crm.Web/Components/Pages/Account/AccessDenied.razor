@page "/access-denied"
@layout EmptyLayout

<PageTitle>Truy cập bị từ chối</PageTitle>

<div class="auth-center-container">
    <MudPaper Class="pa-8 text-center access-denied-paper" Elevation="4">
        <MudIcon Icon="@Icons.Material.Filled.Block" Color="MudBlazor.Color.Error" Style="font-size: 72px;" />
        <MudText Typo="MudBlazor.Typo.h4" Class="mt-3">Truy cập bị từ chối</MudText>
        <MudText Typo="MudBlazor.Typo.body1" Class="mt-2">Bạn không có quyền truy cập trang này.</MudText>
        <MudButton Href="/" Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Primary" Class="mt-4">
            Về trang chủ
        </MudButton>
    </MudPaper>
</div>