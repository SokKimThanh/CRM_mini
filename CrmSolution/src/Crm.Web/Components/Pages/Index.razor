@page "/demo-interactive"
@rendermode InteractiveServer

<PageTitle>Blazor Server Proof of Concept</PageTitle>

<MudText Typo="Typo.h4" Color="MudBlazor.Color.Primary" Class="mb-2 font-weight-bold">
    Blazor Server Proof of Concept — Day 1
</MudText>
<MudText Typo="Typo.subtitle1" Color="MudBlazor.Color.Secondary" Class="mb-6">
    Kiểm thử cơ chế Interactive Server Component, C# Event Binding, State in-memory và Live Search qua SignalR Persistent Circuit.
</MudText>

@* Test 1: Load Component bằng sự kiện C# *@
<MudPaper Class="pa-6 mb-6" Elevation="3">
    <MudText Typo="Typo.h6" Class="mb-2">
        <MudIcon Icon="@Icons.Material.Filled.FlashOn" Class="mr-2" />
        Test 1: Render Component Con bằng C# Event (Không Reload Trang)
    </MudText>
    <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary" Class="mb-3">
        Kích hoạt sự kiện OnClick để gán chuỗi trạng thái và render MessageComponent.
    </MudText>
    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.Download" OnClick="LoadMessage" Class="my-2">
        Bấm để tải tin nhắn
    </MudButton>
    <MudPaper Class="pa-4 mt-3" Elevation="0" Style="background: #fafafa; border: 1px dashed #bdbdbd;">
        @if (string.IsNullOrEmpty(message))
        {
            <MudText Color="MudBlazor.Color.Default" Typo="Typo.body2">
                Chưa có dữ liệu từ server...
            </MudText>
        }
        else
        {
            <MessageComponent Message="@message" />
        }
    </MudPaper>
</MudPaper>

@* Test 2: Counter phía server *@
<MudPaper Class="pa-6 mb-6" Elevation="3">
    <MudText Typo="Typo.h6" Class="mb-2">
        <MudIcon Icon="@Icons.Material.Filled.AddCircle" Class="mr-2" />
        Test 2: Server-side State Management (Persistent Circuit)
    </MudText>
    <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary" Class="mb-3">
        Biến đếm được lưu trên RAM máy chủ, đồng bộ qua WebSocket binary stream.
    </MudText>
    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Success" StartIcon="@Icons.Material.Filled.PlusOne" OnClick="IncrementCounter" Class="my-2">
        Bấm để tăng bộ đếm
    </MudButton>
    <div class="mt-3">
        <CounterComponent Count="@counter" />
    </div>
</MudPaper>

@* Test 3: Live Search với debounce *@
<MudPaper Class="pa-6" Elevation="3">
    <MudText Typo="Typo.h6" Class="mb-2">
        <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" />
        Test 3: Live Search Realtime (Debounce 300ms)
    </MudText>
    <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary" Class="mb-3">
        Nhập liệu tức thì qua MudTextField (Immediate="true"), debounce lọc dữ liệu in-memory.
    </MudText>
    <MudTextField @bind-Value="searchKeyword" @bind-Value:after="OnSearchChanged" Placeholder="Nhập từ khóa (vd: Cơ khí, Bulong, Máy)..." Variant="Variant.Outlined" Immediate="true" Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="my-2" />
    <div class="mt-3">
        <SearchComponent Results="@searchResults" />
    </div>
</MudPaper>

@code {
    private string? message;
    private int counter = 0;
    private string? searchKeyword;
    private List<string> searchResults = new();
    private CancellationTokenSource? _searchCts;

    private static readonly List<string> _allItems = new()
    {
        "Nhà máy Cơ khí An Phát",
        "Cơ khí Chính xác Việt Nhật",
        "Khuôn Mẫu Tân Á",
        "Bulong Ốc Vít Nam An",
        "Dụng Cụ Hải Nam",
        "Cơ Khí Thắng Lợi",
        "Chế Tạo Máy Minh Đức",
        "Bơm Công Nghiệp Sài Gòn"
    };

    private void LoadMessage()
    {
        message = $"Dữ liệu phản hồi từ Blazor Circuit lúc {DateTime.Now:HH:mm:ss.fff}";
    }

    private void IncrementCounter()
    {
        counter++;
    }

    private async Task OnSearchChanged()
    {
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await Task.Delay(300, token);
            if (string.IsNullOrWhiteSpace(searchKeyword))
            {
                searchResults = new List<string>();
            }
            else
            {
                searchResults = _allItems
                    .Where(x => x.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }
        }
        catch (TaskCanceledException)
        {
            // Bỏ qua ngoại lệ khi người dùng gõ phím liên tục
        }
    }
}